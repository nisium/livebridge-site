---
import "../styles/global.css";
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={base + "brand/logo.svg"} />
</head>
<body>
  <nav class="top"><div class="wrap">
    <a class="brand" href={base}><img src={base + "brand/logo.svg"} alt="LiveBridge" width="100" height="21" /></a>
    <a class="hide" href={base + "#features"}>Features</a>
    <a class="hide" href={base + "#custom"}>Customize</a>
    <a href={base + "privacy/"}>Privacy</a>
    <a href={base + "terms/"}>Terms</a>
  </div></nav>
  <slot />
  <footer>
    <img src={base + "brand/logo.svg"} alt="LiveBridge" width="80" height="17" style="opacity:.7;margin-bottom:10px" /><br />
    by NLG · Not affiliated with TikTok, YouTube, Google or OBS Project. All names and logos belong to their owners.<br />
    <a href={base + "privacy/"}>Privacy Policy</a> · <a href={base + "terms/"}>Terms</a> · <a href="https://github.com/nisium/livebridge-site/issues">Contact</a>
  </footer>
</body>
</html>
