---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import RichText from "@/components/typography/RichText.astro";
import { url } from "@/utils/url.ts";
---

<Layout
  theme="dark"
  title="Terms of Use"
  description="Terms of use for LiveBridge."
>
  <!-- document -->
  <Section paddingTop="medium" paddingBottom="large">
    <ContentWrapper>
      <Eyebrow>Last updated: 18 October 2026</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={17}>Terms of Use</Heading>
      <RichText maxWidth={60}>
        <ul>
          <li>
            LiveBridge is provided "as is", without warranty of any kind. Use it
            at your own risk.
          </li>
          <li>
            You are responsible for following the rules of TikTok, YouTube and
            Google when you use it, including their terms of service.
          </li>
          <li>
            LiveBridge is not affiliated with or endorsed by TikTok, YouTube,
            Google or the OBS Project. All names and logos belong to their
            owners.
          </li>
          <li>
            Platforms can change how their data works at any time, so some
            features may stop working without notice.
          </li>
          <li>
            To stop using LiveBridge, press Disconnect in Settings and uninstall
            the plugin. See the <a href={url("/privacy")}>Privacy Policy</a> for what
            is stored.
          </li>
        </ul>
      </RichText>
    </ContentWrapper>
  </Section>
</Layout>
