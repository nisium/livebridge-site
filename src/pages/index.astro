---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import GradientBackground from "@/components/media/GradientBackground.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { DISCORD_URL, KEY_SERVICE_URL } from "@/consts.ts";
import KeyDownload from "@/components/content/KeyDownload.astro";
import HeroMockup from "@/components/content/HeroMockup.astro";
import ph_chats from "@/assets/icons/ph-chats-fill.svg";
import ph_gift from "@/assets/icons/ph-gift-fill.svg";
import ph_chart_bar from "@/assets/icons/ph-chart-bar-fill.svg";
import ph_users from "@/assets/icons/ph-users-fill.svg";
import ph_pulse from "@/assets/icons/ph-pulse-fill.svg";
import ph_layout from "@/assets/icons/ph-layout-fill.svg";
import hero_mockup from "@/assets/graphics/hero-mockup.png";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Card from "@/components/item/Card.astro";
import Marquee from "@/components/interactive/Marquee.astro";
import Icon from "@/components/media/Icon.astro";
import tiktok from "@/assets/icons/tiktok.svg";
import youtube from "@/assets/icons/youtube.svg";
import twitch from "@/assets/icons/twitch.svg";
import kick from "@/assets/icons/kick.svg";
import CustomizeTab from "@/components/content/CustomizeTab.astro";
import Tabs from "@/components/interactive/Tabs.astro";
import TabLink from "@/components/interactive/TabLink.astro";
import customize_display from "@/assets/graphics/customize-display.png";
import customize_counters from "@/assets/graphics/customize-counters.png";
import customize_accounts from "@/assets/graphics/customize-accounts.png";
import customize_docks from "@/assets/graphics/customize-docks.png";
import discord2 from "@/assets/icons/discord.svg";
import ph_desktop from "@/assets/icons/ph-desktop-fill.svg";
import ph_cloud_slash from "@/assets/icons/ph-cloud-slash-fill.svg";
import ph_eye from "@/assets/icons/ph-eye-fill.svg";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import latest from "@/data/latest.json";
import { url } from "@/utils/url.ts";
---

<Layout theme="dark" overlap={true}>
  <Section
    paddingBottom="none"
    containerClass="flex-grow"
    paddingTop="navoverlap"
    class="flex-grow"
    fullHeight={true}
    gap="0"
  >
    <GradientBackground slot="background" />
    <ContentWrapper centered={true} class="flex-grow">
      <Heading tag="h1" variant="display" class="heading-accent" maxWidth={12}
        >Every live chat, <strong>in one dock</strong>.</Heading
      >
      <Paragraph maxWidth={40}
        >TikTok and YouTube chat, gifts and counters inside OBS Studio. Private,
        on your computer.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href={DISCORD_URL} icon={discord2}
          >Request early access<Icon /></Button
        >
        <Button element="link" href="#features" emphasis="secondary"
          >See what it does</Button
        >
      </ButtonWrapper>
      <Paragraph
        variant="xsmall"
        class="color-faded"
        render={Boolean(latest.version)}
        >{
          `LiveBridge v${latest.version}${latest.sizeMb ? ` · ${latest.sizeMb} MB` : ""} · Installer not signed`
        }</Paragraph
      >
    </ContentWrapper>
    <HeroMockup
      src={hero_mockup}
      alt="LiveBridge in OBS Studio: the Gifts dock, the main dock with counters and chat, and the Events dock"
    />
  </Section>
  <Section paddingTop="none" paddingBottom="none"
    ><Marquee label="Supported platforms">
      <Paragraph variant="large">TikTok</Paragraph>
      <Icon src={tiktok} variant="large" />
      <Paragraph variant="large">YouTube</Paragraph>
      <Icon src={youtube} variant="large" />
      <Paragraph variant="large">Twitch</Paragraph>
      <Icon src={twitch} variant="large" />
      <Paragraph variant="large">Kick</Paragraph>
      <Icon src={kick} variant="large" />
    </Marquee></Section
  >
  <Section id="features"
    ><ContentWrapper centered={true}>
      <Eyebrow>BUILT BY STREAMERS, FOR STREAMERS</Eyebrow>
      <Heading maxWidth={10}>All your chats. One place.</Heading>
      <Paragraph>Less switching. More streaming.</Paragraph>
    </ContentWrapper><Grid small={2} medium={3} class="gap-2">
      <Card
        icon={ph_chats}
        heading="One unified chat"
        text="Every platform. One chat."
      />
      <Card
        icon={ph_gift}
        heading="Real-time gifts"
        text="Every gift, every detail."
      />
      <Card
        icon={ph_chart_bar}
        heading="Live stats"
        text="Your numbers, at a glance."
      />
      <Card
        icon={ph_users}
        heading="Community activity"
        text="Follows, shares and more."
      />
      <Card
        icon={ph_pulse}
        heading="Live activity feed"
        text="Never miss a moment."
      />
      <Card
        icon={ph_layout}
        heading="Your OBS, your way"
        text="One dock or multiple panels."
      />
    </Grid></Section
  >
  <Section id="customize" paddingTop="none">
    <ContentWrapper centered={true}>
      <Eyebrow>MAKE IT YOURS</Eyebrow>
      <Heading maxWidth={22}>Show what you want. Hide what you don't.</Heading>
      <Paragraph maxWidth={46}
        >Every part of the chat can be turned on or off from a clear Settings
        screen. Nothing is taken away unless you say so.</Paragraph
      >
    </ContentWrapper>
    <Tabs id="settings" playback="auto">
      <Fragment slot="links">
        <TabLink>Display</TabLink>
        <TabLink>Counters</TabLink>
        <TabLink>Accounts</TabLink>
        <TabLink>Extra docks</TabLink>
      </Fragment>
      <CustomizeTab
        heading="Display, in three simple blocks"
        text="Choose what shows in the main chat, add an events area above it like TikTok's own, and turn the activity line on or off."
        points={[
          "Main Chat: messages, gifts and support, follows and bans",
          "Above the Main Chat: an events area, drag its bar to resize",
          "Under the Chat: a calm activity line, one viewer at a time",
        ]}
        image={customize_display}
        alt="Display, in three simple blocks"
      />
      <CustomizeTab
        heading="Counters, platform by platform"
        text="Hide a whole platform or pick the exact numbers you want. Each number belongs to a platform, so you never wonder where it comes from."
        points={[
          "Hide TikTok or YouTube in one click",
          "Choose viewers, likes, followers, gifts and more",
          "Only connected platforms show up in the dock",
        ]}
        image={customize_counters}
        alt="Counters, platform by platform"
      />
      <CustomizeTab
        heading="No passwords, no servers"
        text="Type your TikTok username, or sign in with Google for YouTube. LiveBridge reconnects when OBS opens, and you can disconnect any time."
        points={[
          "TikTok: just your username",
          "YouTube: Google sign-in, read-only access",
          "Everything stays on your computer",
        ]}
        image={customize_accounts}
        alt="No passwords, no servers"
      />
      <CustomizeTab
        heading="Extra docks for your layout"
        text="Add LiveBridge Gifts and LiveBridge Events from the Docks menu of OBS and place them anywhere. Nothing is taken away from the main chat."
        points={[
          "LiveBridge Gifts: gifts, Super Chats, new members",
          "LiveBridge Events: follows, shares, subscribers, bans",
          "Place them wherever you want in OBS",
        ]}
        image={customize_docks}
        alt="Extra docks for your layout"
      />
    </Tabs>
  </Section>
  <Section id="privacy" paddingTop="none">
    <ContentWrapper variant="sticky-content">
      <Eyebrow>PRIVACY FIRST</Eyebrow>
      <Heading maxWidth={14}>Runs on your computer. Period.</Heading>
      <Paragraph maxWidth={40}
        >There is no LiveBridge server, no account and no analytics. Your chat
        never leaves your PC.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href={url("/privacy")} emphasis="secondary"
          >Read the Privacy Policy</Button
        >
      </ButtonWrapper>
      <Grid class="gap-2" slot="column2">
        <Card
          icon={ph_desktop}
          heading="Local only"
          text="The helper service listens only on your own computer. Nobody on your network can reach it."
        />
        <Card
          icon={ph_cloud_slash}
          heading="Zero accounts, zero servers"
          text="We never receive your chat, your tokens or your data. No trackers, no ads."
        />
        <Card
          icon={ph_eye}
          heading="Read-only"
          text="On YouTube the app can only read. It never posts, deletes or changes anything."
        />
      </Grid>
    </ContentWrapper>
  </Section>
  <Section id="faq">
    <ContentWrapper variant="sticky-content">
      <Eyebrow>FAQ</Eyebrow>
      <Heading maxWidth={12}>Questions, answered.</Heading>
      <Paragraph maxWidth={28}>Anything else? Ask us on Discord.</Paragraph>
      <ButtonWrapper>
        <Button element="link" href={DISCORD_URL} icon={discord2}
          >Ask on Discord</Button
        >
      </ButtonWrapper>
      <Accordion slot="column2" openFirst={true}>
        <AccordionItem heading="Which platforms are supported?">
          <Paragraph
            >TikTok LIVE and YouTube Live. Twitch and Kick are planned, but not
            available yet.</Paragraph
          >
        </AccordionItem>
        <AccordionItem heading="Which systems does it run on?">
          <Paragraph
            >Windows with OBS Studio. The installer finds your OBS folder and
            lets you confirm it before installing anything.</Paragraph
          >
        </AccordionItem>
        <AccordionItem heading="How do I get it?">
          <Paragraph
            >LiveBridge is in early access. Join our Discord and request access:
            we send you a personal key. With it you download the installer
            right here on this page.</Paragraph
          >
        </AccordionItem>
        <AccordionItem heading="Windows says the app is unknown. Is it safe?">
          <Paragraph
            >The installer is not code-signed yet, so Windows SmartScreen may
            warn you. Choose “More info” and then “Run anyway”. The plugin only
            runs inside OBS and only talks to TikTok and Google.</Paragraph
          >
        </AccordionItem>
        <AccordionItem heading="Does it send my chat anywhere?">
          <Paragraph
            >No. Your chat, gifts and Google data stay on your computer. The
            only things LiveBridge sends to our key service are your access key,
            a random id of your computer and the version number, to check that
            the key is valid and to look for updates. No analytics.</Paragraph
          >
        </AccordionItem>
        <AccordionItem heading="Can it moderate my chat?">
          <Paragraph
            >Not yet. It shows what happens, for example YouTube bans and
            timeouts, but it does not act on your behalf.</Paragraph
          >
        </AccordionItem>
        <AccordionItem heading="Why does TikTok show more than LiveBridge?">
          <Paragraph
            >TikTok does not offer an official live API. LiveBridge reads the
            public data of your live, so some app-only items, like some emoji
            codes, can look different.</Paragraph
          >
        </AccordionItem>
      </Accordion>
    </ContentWrapper>
  </Section>
  <Section id="download" paddingTop="none">
    <ContentWrapper centered={true}>
      <Eyebrow>ALREADY HAVE A KEY?</Eyebrow>
      <Heading maxWidth={14}>Download LiveBridge.</Heading>
      <Paragraph maxWidth={30}
        >Enter the key we gave you. After installing, open OBS and LiveBridge
        recognises it by itself.</Paragraph
      >
      <KeyDownload service={KEY_SERVICE_URL} />
    </ContentWrapper>
  </Section>
  <Section id="join" paddingTop="none" paddingBottom="small">
    <ContentWrapper variant="card">
      <Eyebrow>EARLY ACCESS</Eyebrow>
      <Heading class="heading-accent" maxWidth={14}
        >One place for <strong>your whole live</strong>.</Heading
      >
      <Paragraph maxWidth={36}
        >Join our Discord, request access and get LiveBridge before everyone
        else.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href={DISCORD_URL} icon={discord2}
          >Request early access</Button
        >
      </ButtonWrapper>
      <GradientBackground slot="column2" />
    </ContentWrapper>
  </Section>
</Layout>
