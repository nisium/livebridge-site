---
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/logo/logo.svg";
import { SITE_NAME, DISCORD_URL } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
import discord from "@/assets/icons/discord.svg";
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner" data-lenis-prevent>
            <ul class="nav_links">
              <li class="nav_indicator" aria-hidden="true" />
              <NavLink href="/#features">What it does</NavLink>
              <NavLink href="/#customize">Make it yours</NavLink>
              <NavLink href="/#faq">FAQ</NavLink>
            </ul>
            <div class="nav_cta">
              <Button element="link" href={DISCORD_URL} icon={discord}>
                Request early access
              </Button>
            </div>
          </div>
        </nav>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const menu = document.querySelector<HTMLElement>(".nav_links");
  const pill = menu?.querySelector<HTMLElement>(".nav_indicator");

  if (menu && pill) {
    const links = Array.from(menu.querySelectorAll<HTMLElement>(".nav_link"));
    let current = menu.querySelector<HTMLElement>(
      ".nav_link[aria-current='page']",
    );
    let hovering = false;

    const move = (link: HTMLElement, snap = false) => {
      const box = menu.getBoundingClientRect();
      const rect = link.getBoundingClientRect();
      pill.classList.toggle("snap", snap);
      pill.style.setProperty("--_x", `${rect.left - box.left}px`);
      pill.style.setProperty("--_y", `${rect.top - box.top}px`);
      pill.style.setProperty("--_w", `${rect.width}px`);
      pill.style.setProperty("--_h", `${rect.height}px`);
      pill.classList.add("visible");
      if (snap) {
        void pill.offsetWidth;
        pill.classList.remove("snap");
      }
    };

    const rest = () => {
      if (current) move(current);
      else pill.classList.remove("visible");
    };

    const enter = (link: HTMLElement) =>
      move(link, !pill.classList.contains("visible"));

    links.forEach((link) => {
      link.addEventListener("mouseenter", () => enter(link));
      link.addEventListener("focus", () => enter(link));
      link.addEventListener("blur", rest);
    });
    menu.addEventListener("mouseenter", () => (hovering = true));
    menu.addEventListener("mouseleave", () => {
      hovering = false;
      rest();
    });

    /* The link of the section that is on screen is marked, and the pill rests on it */
    const spied = links
      .map((link) => {
        const url = new URL(link.getAttribute("href") ?? "", location.href);
        const target =
          url.pathname === location.pathname && url.hash
            ? document.querySelector<HTMLElement>(url.hash)
            : null;
        return target ? { link, target } : null;
      })
      .filter((item): item is { link: HTMLElement; target: HTMLElement } =>
        Boolean(item),
      );

    if (spied.length) {
      const spy = () => {
        const line = window.innerHeight * 0.4;
        let active: HTMLElement | null = null;
        for (const { link, target } of spied) {
          const box = target.getBoundingClientRect();
          if (box.top <= line && box.bottom > line) active = link;
        }
        if (active === current) return;
        current?.removeAttribute("aria-current");
        current = active;
        current?.setAttribute("aria-current", "location");
        if (hovering) return;
        if (current) move(current, !pill.classList.contains("visible"));
        else pill.classList.remove("visible");
      };
      let frame = 0;
      window.addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(spy);
        },
        { passive: true },
      );
      spy();
    }
    window.addEventListener("resize", () => current && move(current, true));
    document.fonts?.ready.then(() => current && move(current, true));
    if (current) move(current, true);
  }

  const nav = document.querySelector<HTMLElement>(".nav_wrap");

  if (nav) {
    const update = () => nav.classList.toggle("scrolled", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: transparent;
      color: var(--text);
      border-bottom: var(--border-width) solid transparent;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);

      &.scrolled,
      &.open {
        background-color: var(--background);
        border-bottom-color: var(--border);
      }

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 7.5rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_cta {
      padding: var(--space-3) var(--site-margin) var(--space-4);
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: color-mix(in lab, currentcolor 60%, transparent);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-4);
        font-size: var(--text-small);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_links {
        position: relative;
        gap: var(--space-1);
      }

      .nav_inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
      }

      .nav_menu,
      .nav_menu_inner {
        display: contents;
      }

      .nav_cta {
        justify-self: end;
        padding: 0;
      }

      .nav_link {
        position: relative;
        z-index: 1;
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-small);
      }

      /* The pill that slides to the hovered link, and rests on the current page */
      .nav_indicator {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: var(--_w, 0);
        height: var(--_h, 0);
        transform: translate(var(--_x, 0), var(--_y, 0));
        background-color: var(--dark-800);
        border-radius: var(--radius-small);
        opacity: 0;
        pointer-events: none;
        transition:
          transform 350ms cubic-bezier(0.4, 0, 0.2, 1),
          width 350ms cubic-bezier(0.4, 0, 0.2, 1),
          height 350ms cubic-bezier(0.4, 0, 0.2, 1),
          opacity var(--hover-duration) var(--hover-ease);

        &.visible {
          opacity: 1;
        }

        &.snap {
          transition: opacity var(--hover-duration) var(--hover-ease);
        }
      }
    }

    @media (width < 48rem) {
      .nav_indicator {
        display: none;
      }
    }
  }
</style>
